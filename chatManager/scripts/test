#!/usr/bin/env bash
# Everything about the chat plugin that can be checked without a running shell.
#
#   - the manager's Go tests
#   - every QML file parses
#   - the QtTest suites in tests/
#
# The QML in here cannot be loaded outside DMS -- it imports qs.Common and the
# rest of the shell -- so what is tested is what stands on its own: the link
# rules a message goes through, and the key behaviour the whole keymap rests on.
# Both were bugs before they were tests.
set -euo pipefail

cd "$(dirname "$0")/.."
plugin=$(pwd)
failures=0

step() {
    printf '\n== %s\n' "$1"
}

find_qt_tool() {
    local name=$1
    local found
    found=$(command -v "$name" 2>/dev/null) && {
        printf '%s' "$found"
        return 0
    }
    # Qt's tools are not on PATH on every distribution; NixOS keeps them in the
    # store, Arch under /usr/lib/qt6/bin.
    for candidate in /usr/lib/qt6/bin/"$name" /usr/lib/qt/bin/"$name"; do
        [ -x "$candidate" ] && {
            printf '%s' "$candidate"
            return 0
        }
    done

    # The Qt quickshell itself runs on, so the tests see what the shell does.
    # Key handling differs between Qt releases: picked by store path, this
    # found an older Qt beside the shell's, whose text field takes Ctrl+V
    # differently, and two paste tests failed that pass where it matters. On
    # NixOS bin/quickshell is a small wrapper beside the real program.
    local qs qt bin
    qs=$(readlink -f "$(command -v quickshell 2>/dev/null)" 2>/dev/null) || true
    if [ -n "$qs" ]; then
        for bin in "$(dirname "$qs")/.quickshell-wrapped" "$qs"; do
            [ -f "$bin" ] || continue
            qt=$(ldd "$bin" 2>/dev/null | sed -n 's|.*=> \(/nix/store/[^/]*qtdeclarative[^/]*\)/lib/libQt6Quick\.so.*|\1|p' | head -1)
            if [ -n "$qt" ] && [ -x "$qt/bin/$name" ]; then
                printf '%s' "$qt/bin/$name"
                return 0
            fi
        done
    fi

    # Otherwise the newest Qt 6 there is -- by version, not by store hash.
    found=$(find /nix/store -maxdepth 3 -type f -name "$name" -path '*qtdeclarative-6*/bin/*' 2>/dev/null |
        sed -E 's|.*qtdeclarative-([0-9.]+)/.*|\1 &|' | sort -V | tail -1 | cut -d' ' -f2-)
    [ -n "$found" ] && printf '%s' "$found"
}

step "go test"
if command -v go >/dev/null 2>&1; then
    (cd src && CGO_ENABLED=0 go test ./...)
else
    echo "skipped: no go in PATH"
fi

qmllint=$(find_qt_tool qmllint || true)
step "qml parses"
if [ -n "$qmllint" ]; then
    # Only errors matter here: the imports cannot resolve outside the shell, so
    # the warnings are all about qs.* being absent. A syntax error is one of
    # those warnings in newer qmllint -- tagged [syntax] rather than called an
    # error -- so it is looked for by name.
    for component in *.qml; do
        if "$qmllint" "$component" 2>&1 | grep -E ': Error|\[syntax\]'; then
            echo "FAIL: $component"
            failures=$((failures + 1))
        fi
    done
    [ "$failures" -eq 0 ] && echo "ok: $(ls -1 *.qml | wc -l) files"
else
    echo "skipped: no qmllint found"
fi

qmltestrunner=$(find_qt_tool qmltestrunner || true)
step "qmltest"
if [ -n "$qmltestrunner" ]; then
    # Where the tool lives is where its QML modules live, which is not the
    # default import path on a distribution that keeps Qt out of /usr.
    qml_modules="${qmltestrunner%/bin/*}/lib/qt-6/qml"
    imports=()
    [ -d "$qml_modules" ] && imports=(-import "$qml_modules")

    log=$(mktemp "${TMPDIR:-/tmp}/dms-chat-qmltest-XXXXXX.log")
    trap 'rm -f "$log"' EXIT

    for suite in tests/tst_*.qml; do
        if QT_QPA_PLATFORM=offscreen "$qmltestrunner" "${imports[@]}" -input "$plugin/$suite" >"$log" 2>&1; then
            echo "ok: $suite ($(grep -c '^PASS' "$log") passed)"
        else
            grep -E '^(FAIL|QWARN|Totals)' "$log" || cat "$log"
            echo "FAIL: $suite"
            failures=$((failures + 1))
        fi
    done
else
    echo "skipped: no qmltestrunner found"
fi

printf '\n'
if [ "$failures" -ne 0 ]; then
    echo "FAILED: $failures"
    exit 1
fi
echo "PASSED"
